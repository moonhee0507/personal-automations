<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.day.storage-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/venv/bin/python</string>
        <string>-m</string>
        <string>storage_optimizer.cli</string>
        <string>scan</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/personal-automations/storage-scan.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/personal-automations/storage-scan.err.log</string>
</dict>
</plist>
